  "sanctuaries": {
    "lankeCrag": {
      "id": "lanke-chess-crag",
      "name": "东岭烂柯石枰",
      "action": "观局",
      "x": 156.0,
      "z": -164.0,
      "radius": 4.2,
      "lines": [
        "青石枰上残局未收，黑白溪石棋子微沾松花——不知山中长者弈罢归去，已历几度春秋。",
        "石凳生满苍苔，旁置一只素匏酒葫芦，山风拂过苍松，松子偶落石枰铮然有声。",
        "抬眼西望，观云亭与千亩良田尽在脚下烟霭之中，真乃『山中无甲子，寒尽不知年』。"
      ]
    },
    "logBridge": {
      "id": "split-log-bridge",
      "name": "东涧独木山桥",
      "action": "临涧",
      "x": 148.5,
      "z": -123.5,
      "yaw": -0.38,
      "length": 5.4,
      "width": 1.35,
      "radius": 3.6,
      "lines": [
        "劈杉为桥横跨清涧，桥下活水漱玉穿苔，两岸野薇与山蕨随湿风轻摇。",
        "涧边扁石上搁着一只采药竹篓，清泉自东岭岩隙淙淙而下，掬水入口清冽甘甜。"
      ]
    },
    "climbingKiln": {
      "id": "ancient-climbing-kiln",
      "name": "山阿秦汉古窑",
      "action": "探窑",
      "x": 136.5,
      "z": -221.5,
      "rot": -0.52,
      "radius": 5.0,
      "lines": [
        "依东北山阿缓坡筑起馒头土窑，取谷中澄泥抟作瓮缶耳杯，松柴余温尚暖。",
        "晾坯茅棚下整齐排开未施釉的灰陶瓮与三足鬲，村人盛春酒、贮秋粟皆赖此窑。",
        "窑膛火门微透红炭暖光，一缕淡白窑烟顺松梢袅袅融进北岭云气。"
      ]
    },
    "deerHermitage": {
      "id": "deer-brushwood-hermitage",
      "name": "西岭鹿柴望川台",
      "action": "凭栏",
      "x": -82.0,
      "z": -176.0,
      "rot": 1.35,
      "radius": 4.8,
      "lines": [
        "空山不见人，唯见竹篱柴扉半掩、青苔返景；林下双鹿安然食苹，见客亦不惊避。",
        "登临木栈凭栏东望，全村屋舍俨然、美池桑竹与远山横云尽收画卷之中。"
      ]
    },
    "mountainTeaHut": {
      "id": "mountain-tea-shelter",
      "name": "北岭松风茶寮",
      "action": "品茗",
      "x": 82.0,
      "z": -235.5,
      "rot": 0.28,
      "radius": 4.6,
      "lines": [
        "半山樵径转入松阴，四柱茅顶茶寮下泥炉微沸，竹匾摊着刚采的带露野茶，清香扑鼻。",
        "担柴樵夫与采茶山姑常在此歇肩饮泉，俯望谷中层梯水镜与千家炊烟，山上山下皆是人间暖意。"
      ]
    },
    "woodcutterHut": {
      "id": "cloud-ridge-woodcutter-hut",
      "name": "西岭云樵茅舍",
      "action": "访樵",
      "x": -68.0,
      "z": -234.0,
      "rot": 0.72,
      "radius": 4.6,
      "lines": [
        "依西北云岭缓坡筑起夯土茅舍，廊下码满松柴与竹扁担，劈柴木墩上犹留松脂清香。",
        "屋脊矮烟囱飘出一缕淡白炊烟，与山下村落遥遥相望，空山深处亦有人家安居。"
      ]
    }
  },
