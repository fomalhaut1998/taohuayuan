  "interactions": {
    "teaStove": {
      "id": "borderland-tea-stove",
      "name": "山泉竹炉茶灶",
      "action": "烹泉试茗",
      "lines": [
        "揭开瓦铫轻扇松枝——北涧活水蟹眼初生，新焙云雾野茶清香满坞。",
        "竹杓分汤入粗陶盏，茶烟随山岚袅袅升起，入口微苦回甘，顿觉尘虑皆消。",
        "泥炉红炭微明，铫中松风谡谡作响，半瓯山茗饮罢，两腋习习生风。"
      ]
    },
    "ancientStele": {
      "id": "borderland-qin-stele",
      "name": "避秦记事残碑",
      "action": "拂苔辨字",
      "lines": [
        "拂去苍苔，见青石阴刻古隶残字：「先世避乱入谷，凿渠开畴，种茶植杏，子孙永守清平……」",
        "指尖摩挲漫漶石纹，碑背尚存先民刻下的春分祀社、谷雨采茶农事节候。",
        "残碑半没芳草松阴间，字迹古拙质朴，不记帝王年号，唯录岁稔人和。"
      ]
    }
  },
