    "ancientAltar": {
      "id": "ancient-qin-altar",
      "name": "西南古社避秦坛",
      "action": "拜社",
      "x": -124.0,
      "z": -116.0,
      "rot": 0.36,
      "radius": 5.0,
      "lines": [
        "古樟巨荫遮覆两级苍苔石坛，朱赭素幡随山风轻扬，犹存先世春祈秋报之古礼。",
        "社柱前摆着陶盘鲜果与新收粟穗竹筐，村人每逢社日便来此敬祷岁稔人和。",
        "青石社铭仅刻『避秦保聚，永敦邻好』八字，不记年号，唯见山风松响历久常新。"
      ]
    },
    "secludedStudy": {
      "id": "cold-spring-study",
      "name": "北涧冷泉幽轩",
      "action": "展简",
      "x": 60.0,
      "z": -296.0,
      "rot": -0.24,
      "radius": 4.8,
      "lines": [
        "青瓦木轩依北山高台而筑，崖间竹笕引来冷泉入苔石方池，水声清泠如叩玉磬。",
        "凭轩南望，层梯水镜与千亩良田铺展在烟霭之中，案头韦编竹简正摊开四时农谚。",
        "长日静读不觉暮色渐浓，青铜油灯微明，唯有山泉与松涛伴人翻卷。"
      ]
    },
    "jadeTeaTerrace": {
      "id": "jade-rill-tea-terrace",
      "name": "东南碧涧茶坞",
      "action": "试茶",
      "x": 186.0,
      "z": -114.0,
      "rot": -0.54,
      "radius": 4.8,
      "lines": [
        "东涧源头云雾常聚，四弧老茶垄顺着缓坡错落排开，芽叶带着清晨山露。",
        "四柱茅棚下泥灶铁锅微温，松柴清香混着炒青茶气，竹匾上摊满刚焙好的新茗。",
        "山农汲碧涧源水烹了一盏头春老茶，入口鲜爽回甘，满坡碧影令人忘归。"
      ]
    }
  },
